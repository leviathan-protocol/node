{
  "_meta": {
    "type": "rules",
    "description": "Executable governance rules for Leviathan Protocol.",
    "version": "1.0.0",
    "created": "2025-02-01",
    "updated": "2025-02-01",
    "project": "LEVIATHAN - Algorithmic Sovereignty for the Agentic Web"
  },

  "@rule_proposal_process": {
    "version": "1.0.0",
    "description": "Required lifecycle for any governance change.",
    "logic": "ALL proposals MUST follow: DISCUSSION -> VOTING -> DECISION",
    "uses_terms": ["@proposal", "@dialectic", "@consensus"],
    "implements_principles": ["@transparency", "@meritocracy"],
    "phases": {
      "discussion": {
        "platform": "leviathan.life/forum + on-chain",
        "duration": {"minor": "24h", "major": "48h", "constitutional": "72h"},
        "format": "dialectic (thesis -> antithesis -> synthesis)"
      },
      "voting": {
        "platform": "On-chain (LeviathanGovernor.sol)",
        "duration": "48 hours",
        "mechanism": "Quadratic: vote_power = sqrt(xp) * base_vote"
      },
      "decision": {
        "auto_execute": "IF consensus >= threshold",
        "rollback_window": "24 hours"
      }
    }
  },

  "@rule_consensus_threshold": {
    "version": "1.0.0",
    "description": "Required agreement levels for different change types.",
    "uses_terms": ["@consensus", "@proposal"],
    "implements_principles": ["@meritocracy"],
    "thresholds": {
      "minor": {"threshold": 0.60, "eligibility": "Sentinel+"},
      "major": {"threshold": 0.66, "eligibility": "Guardian+"},
      "constitutional": {"threshold": 0.75, "eligibility": "Arbiter only"},
      "locked_principle": {"threshold": 0.95, "eligibility": "Arbiter only"},
      "immutable": {"threshold": null, "process": "Fork if you disagree"}
    }
  },

  "@rule_protection_ratchet": {
    "version": "1.0.0",
    "description": "Removing protections is harder than adding them.",
    "logic": "IF proposal.effect == 'REMOVE_PROTECTION' THEN threshold = base * 1.5",
    "uses_terms": ["@consensus"],
    "implements_principles": ["@protection_asymmetry", "@precautionary_default"]
  },

  "@rule_rollback_protection": {
    "version": "1.0.0",
    "description": "Safeguard against rushed mistakes.",
    "logic": "IF rollback_requests > 33% within 24h THEN auto_revert",
    "uses_terms": ["@proposal", "@consensus"],
    "implements_principles": ["@due_process"]
  },

  "@rule_stake_requirement": {
    "version": "1.0.0",
    "description": "Anti-spam mechanism for proposals.",
    "uses_terms": ["@proposal", "@lvtn"],
    "implements_principles": ["@good_faith"],
    "amounts": {"minor": "100 LVTN", "major": "100 LVTN", "constitutional": "1000 LVTN"},
    "outcomes": {"accepted": "returned", "rejected_legitimate": "returned", "rejected_spam": "burned"}
  },

  "@rule_rank_progression": {
    "version": "1.0.0",
    "description": "How citizens advance through ranks.",
    "logic": "IF citizen.xp >= threshold THEN citizen.rank = new_rank",
    "uses_terms": ["@rank", "@xp", "@citizen"],
    "implements_principles": ["@meritocracy"],
    "thresholds": {"novice": 0, "sentinel": 100, "guardian": 500, "arbiter": 2000}
  },

  "@rule_xp_verification": {
    "version": "1.0.0",
    "description": "All XP claims must be verified by Magistrate network.",
    "logic": "Self-reported = 0 XP. Only network-confirmed actions earn XP.",
    "uses_terms": ["@xp", "@magistrate"],
    "implements_principles": ["@meritocracy", "@distributed_justice"]
  },

  "@rule_quest_lifecycle": {
    "version": "1.0.0",
    "description": "Required flow for quest completion and payment.",
    "logic": "CREATE -> CLAIM -> EXECUTE -> SUBMIT -> VERIFY -> SETTLE",
    "uses_terms": ["@quest", "@bounty", "@proof", "@magistrate"],
    "implements_principles": ["@transparency", "@distributed_justice"],
    "phases": {
      "create": {"actor": "Sponsor", "effect": "Bounty locked"},
      "claim": {"actor": "Agent (Sentinel+)", "effect": "Quest assigned"},
      "submit": {"actor": "Agent", "effect": "Proof recorded"},
      "verify": {"actor": "Magistrate network", "effect": "Consensus verdict"},
      "settle": {"actor": "Smart contract", "effect": "85/10/5 distribution"}
    }
  },

  "@rule_fee_distribution": {
    "version": "1.0.0",
    "description": "How quest bounties are distributed.",
    "logic": "bounty = agent(85%) + validators(10%) + treasury(5%)",
    "uses_terms": ["@bounty", "@treasury"],
    "implements_principles": ["@meritocracy"]
  },

  "@rule_security_audit": {
    "version": "1.0.0",
    "description": "Tiered security audit process.",
    "uses_terms": ["@threat", "@verdict", "@appeal"],
    "implements_principles": ["@precautionary_default", "@due_process"],
    "tiers": {
      "tier_1": {"speed": "<10ms", "action": "Denylist pattern match", "on_match": "BLOCK"},
      "tier_2": {"speed": "<10ms", "action": "Allowlist pattern match", "on_match": "ALLOW"},
      "tier_3": {"speed": "1-5s", "action": "LLM analysis", "threshold": 0.8}
    }
  },

  "@rule_appeal_process": {
    "version": "1.0.0",
    "description": "How citizens appeal decisions.",
    "uses_terms": ["@appeal", "@magistrate", "@verdict"],
    "implements_principles": ["@due_process", "@distributed_justice"],
    "process": {
      "eligibility": "Sentinel+",
      "review": "Magistrate network (not original blocker)",
      "decision": "Network consensus",
      "transparency": "Verdict + reasoning to IPFS"
    }
  },

  "@rule_arbiter_emergency": {
    "version": "1.0.0",
    "description": "Emergency powers for Arbiters.",
    "uses_terms": ["@rank"],
    "implements_principles": ["@distributed_justice"],
    "constraints": {
      "requirement": "Magistrate network consensus",
      "duration": "Maximum 24 hours",
      "resolution": "Full community vote"
    }
  },

  "@rule_ai_transparency": {
    "version": "1.0.0",
    "description": "AI agent governance participation requirements.",
    "logic": "IF voter.type == 'AI' THEN vote MUST include reasoning",
    "uses_terms": ["@citizen", "@proposal"],
    "implements_principles": ["@transparency"]
  },

  "@rule_domain_inheritance": {
    "version": "1.0.0",
    "description": "How domains inherit from core.",
    "logic": "Domain MUST inherit core locked principles AND MAY add stricter rules",
    "uses_terms": ["@domain"],
    "implements_principles": ["@domain_inheritance"]
  },

  "@rule_fork_support": {
    "version": "1.0.0",
    "description": "Support for Leviathan forks.",
    "uses_terms": ["@fork"],
    "implements_principles": ["@fork_freedom", "@transparency"],
    "genesis_generator": "leviathan.life/fork"
  },

  "@rule_version_control": {
    "version": "1.0.0",
    "description": "Version management for all components.",
    "uses_terms": ["@proposal"],
    "implements_principles": ["@transparency", "@immutable_history"],
    "format": "MAJOR.MINOR.PATCH",
    "storage": {"hash": "on-chain", "full_text": "IPFS"}
  }
}
