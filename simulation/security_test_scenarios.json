        "action_type": "shell_execution"
      },
      "expected": {
        "verdict": "BLOCK",
        "risk_level": "CRITICAL"
      }
    },
    {
      "id": "test_009",
      "name": "Safe Disk Usage Check",
      "category": "safe_readonly",
      "input": {
        "source": "direct_user_command",
