  "threat_categories": {
    "destructive_shell": {
      "description": "Commands that can destroy data or system integrity",
      "default_verdict": "BLOCK",
      "default_risk": "CRITICAL"
    },
    "credential_exfiltration": {
      "description": "Commands that access or transmit credentials",
      "default_verdict": "BLOCK",
      "default_risk": "CRITICAL"
    },
    "remote_code_execution": {
      "description": "Commands that execute code from untrusted sources",
      "default_verdict": "BLOCK",
      "default_risk": "CRITICAL"
    },
    "data_exfiltration": {
      "description": "Commands that send data to external destinations",
      "default_verdict": "BLOCK",
      "default_risk": "HIGH"
    },
    "safe_readonly": {
      "description": "Safe commands that only read/display information",
      "default_verdict": "ALLOW",
      "default_risk": "INFO"
    },
    "safe_python": {
      "description": "Safe Python utilities from standard library",
      "default_verdict": "ALLOW",
      "default_risk": "LOW"
    },
    "safe_git": {
      "description": "Safe git commands for repository inspection",
      "default_verdict": "ALLOW",
      "default_risk": "LOW"
    },
    "ambiguous": {
      "description": "Commands that are not malicious but warrant caution",
      "default_verdict": "WARN",
      "default_risk": "MEDIUM"
    }
  }
